# ─────────────────────────────────────────────────────────────────────────────
# SplitTicket API — configuration
# ─────────────────────────────────────────────────────────────────────────────

# There is no encryption key to configure here any more.
#
# A user's Gemini key is encrypted IN THEIR BROWSER, with a key derived from
# their password that never reaches this server. What we store is a blob we
# cannot read — so there is nothing here to protect, rotate, or leak.
# The flip side, which the app states plainly: a forgotten password loses the
# saved Gemini key for good.

# ─────────────────────────────────────────────────────────────────────────────

# Optional. When set, it is required to enrol a NEW device (`X-Signup-Key`
# header) — this is what closes off a public instance without having to manage
# accounts. Empty = anyone can enrol.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SPLITTICKET_SIGNUP_KEY=

# Optional. Fallback Gemini key for users who have not brought their own — the
# only Gemini key this server ever holds. Users with a personal key never touch
# it: their browser calls Google directly.
# Empty = everyone brings their own key, and the app says so explicitly when the
# time comes to scan a receipt.
# A key takes seconds to create at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origins allowed to call the API from a browser, comma-separated. This is the
# ONLY thing the API knows about the front: the two are deployed separately and
# the browser is what puts them in touch. Set the front's public origin here.
#   SPLITTICKET_ALLOWED_ORIGINS=https://splitticket.example.com
# "*" is fine for a personal deployment: authentication is a bearer token and
# not a cookie, so there is no CSRF to worry about.
SPLITTICKET_ALLOWED_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────

# Docker Compose only: host port the API is published on. The port INSIDE the
# container stays 8787.
SPLITTICKET_API_PORT=8787

# Outside Docker only. Under Compose these three are set by docker-compose.yml
# (0.0.0.0:8787, data in the volume mounted on /data) and what you put here is
# ignored.
# SPLITTICKET_HOST=127.0.0.1
# SPLITTICKET_PORT=8787
# SPLITTICKET_DATA_DIR=./data

# Maximum size of a receipt photo (12 MiB by default).
# SPLITTICKET_MAX_IMAGE_BYTES=12582912

# How long photos are kept, in days. 0 = never purge.
# Only the PHOTO is deleted: the receipt, its lines and its split remain.
# Without a purge, photos pile up indefinitely on the volume.
SPLITTICKET_IMAGE_RETENTION_DAYS=90

# Interval between two housekeeping passes, in seconds (24h by default).
# SPLITTICKET_PURGE_INTERVAL_SECONDS=86400
