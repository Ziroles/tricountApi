# HTTP relay authentication key (required, exactly 32 characters).
# You can generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24)[:32])"
TRICOUNT_RELAY_KEY=replace_with_a_32_char_key!

# Relay listen host (default: localhost for local dev, 0.0.0.0 inside Docker)
TRICOUNT_RELAY_HOST=0.0.0.0

# Relay listen port (default: 8787)
TRICOUNT_RELAY_PORT=8787

# Path to the JSON file storing generated Tricount device credentials
# (locally: .tricount-credentials.json in root, in Docker: /data/.tricount-credentials.json)
# TRICOUNT_CREDENTIALS_PATH=/data/.tricount-credentials.json
