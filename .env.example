# ─────────────────────────────────────────────────────────────────────────────
# API SplitTicket — configuration
# ─────────────────────────────────────────────────────────────────────────────

# REQUISE pour que les utilisateurs puissent enregistrer leur clé Gemini.
# Elle sert à chiffrer ces clés au repos ; sans elle, l'API refuse d'en stocker
# une plutôt que de l'écrire en clair sur le disque.
# Générer :  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SPLITTICKET_SECRET_KEY=

# ATTENTION : changer cette valeur rend illisibles les clés déjà enregistrées.
# Les utilisateurs devront simplement ressaisir la leur.

# ─────────────────────────────────────────────────────────────────────────────

# Optionnelle. Quand elle est définie, elle est exigée pour enrôler un NOUVEL
# appareil (en-tête `X-Signup-Key`) — c'est ce qui ferme une instance publique
# sans avoir à gérer de comptes. Vide = n'importe qui peut s'enrôler.
# Générer :  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SPLITTICKET_SIGNUP_KEY=

# Optionnelle. Clé Gemini de repli, utilisée quand l'utilisateur n'a pas
# enregistré la sienne. Vide = chacun apporte sa clé, et l'application le lui
# dit explicitement au moment de lire un ticket.
# Une clé se crée en quelques secondes sur https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. « * » convient à un déploiement personnel : l'authentification est
# un jeton porté et non un cookie, donc il n'y a pas de CSRF à craindre.
SPLITTICKET_ALLOWED_ORIGINS=*

# Écoute (par défaut 127.0.0.1:8787 en local, 0.0.0.0:8787 dans Docker).
SPLITTICKET_HOST=0.0.0.0
SPLITTICKET_PORT=8787

# Emplacement des données : base SQLite, photos, identifiants Tricount.
SPLITTICKET_DATA_DIR=/data

# Taille maximale d'une photo de ticket (12 Mio par défaut).
# SPLITTICKET_MAX_IMAGE_BYTES=12582912

# Durée de conservation des photos, en jours. 0 = ne jamais purger.
# Seule la PHOTO est effacée : le ticket, ses lignes et sa répartition restent.
# Sans purge, les photos s'accumulent indéfiniment sur le volume.
SPLITTICKET_IMAGE_RETENTION_DAYS=90

# Intervalle entre deux passes d'entretien, en secondes (24 h par défaut).
# SPLITTICKET_PURGE_INTERVAL_SECONDS=86400
